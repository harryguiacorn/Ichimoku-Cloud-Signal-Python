# Copy this file to .env. Never commit .env.
KIT_API_KEY=replace-with-your-kit-v4-api-key
KIT_DIGEST_TAG_ID=replace-with-your-digest-tag-id
KIT_SEND_DELAY_MINUTES=10

# Optional OANDA API credentials (required for live OANDA data fetching).
OANDA_ACCESS_TOKEN=
OANDA_ACCOUNT_ID=
# Defaults to the OANDA practice API.
# OANDA_API_URL=https://api-fxpractice.oanda.com/v3

# Optional FXCM integration credentials. The fxcmpy package must be installed
# separately if you use the FXCM integration.
FXCM_ACCESS_TOKEN=